# Copy to frontend/.env. Read at bundle time: rebuild the APK (or web build) after changing.

# Server address the app calls. Use this machine's LAN IP; leave unset to keep the app fully on-device.
EXPO_PUBLIC_API_URL=http://192.168.1.20:8080

# Legal identity shown in the consent sheet and Privacy Notice (DPDP Act 2023). Set before release.
EXPO_PUBLIC_LEGAL_ENTITY=
EXPO_PUBLIC_PRIVACY_URL=
EXPO_PUBLIC_GRIEVANCE_NAME=
EXPO_PUBLIC_GRIEVANCE_EMAIL=
EXPO_PUBLIC_GRIEVANCE_PHONE=
EXPO_PUBLIC_GRIEVANCE_ADDRESS=

# RevenueCat public SDK keys (Premium purchases).
# Everyone gets Premium while testing; false shows the paywall and free-plan limits.
EXPO_PUBLIC_PREMIUM_FOR_ALL=true
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
