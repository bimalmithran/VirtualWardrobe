# docker compose reads this file (copy to .env at the repo root).
POSTGRES_PASSWORD=wardrobe
# Optional: absolute base for image URLs the API returns. Empty = use the Host header the phone sent.
PUBLIC_BASE_URL=
# Baked into the APK built by `docker compose --profile apk run --rm apk`. Use this machine's LAN IP.
EXPO_PUBLIC_API_URL=http://192.168.1.20:8080

# --- Optional features (see INSTALL.md › Settings) ---
# AI stylist: Claude when set, else the built-in basic stylist.
ANTHROPIC_API_KEY=
STYLIST_MODEL=claude-opus-5-5
# Cloud vision for low-end phones; use isnet for commercial deployments (RMBG-1.4 is non-commercial).
VISION_ENABLED=true
VISION_SEGMENTATION=rmbg-1.4
# Premium: the Authorization header value configured on the RevenueCat webhook.
REVENUECAT_WEBHOOK_AUTH=
# Shopping links: a long random secret, plus your affiliate ids.
AFFILIATE_SECRET=
AMAZON_ASSOCIATE_TAG=
AFFILIATE_LINK_WRAPPER=
AFFILIATE_PARTNERS=myntra,ajio,amazon,zara
